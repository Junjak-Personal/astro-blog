---
import { Button } from '@/components/ui/button';
import { Icon } from '@/components/ui/icon';
import { createTranslator, getLocaleFromUrl, localizePath } from '@/i18n';
import BaseLayout from '@/layouts/baseLayout.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslator(locale);
const description = t('site.not_found', 'Page Not Found');
---

<BaseLayout title="404" description={description}>
  <div class="container">

    <div class="noti-wrapper">
      <div>
        <div class="noti-404">
          <div class="text">4</div>
          <Icon className="notfi-icon mx-auto" icon="mingcute:sad-fill" client:visible></Icon>
          <div class="text">4</div>
        </div>


        <h2 class="text-center">
          {t('site.not_found', 'Page Not Found')}
        </h2>
        <div class="text-center mt-4">
          <Button variant="default" asChild>
            <a href={localizePath('/', locale)} data-testid="not-found-home-link">
              {t('site.back_home', 'Back to Home')}
            </a>
          </Button>
        </div>

      </div>

    </div>




  </div>
</BaseLayout>
