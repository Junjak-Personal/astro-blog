---
// Component Imports
import EachArticles from '@/components/Project/EachArticles';
import { createTranslator, getLocaleFromUrl, localizePath } from '@/i18n';
import BaseLayout from '@/layouts/baseLayout.astro';
import { getLocalizedCollection } from '@/utils/localizedContent';

const locale = getLocaleFromUrl(Astro.url);
const projects = await getLocalizedCollection('playground', locale);
projects.sort((a, b) => {
  const aDate = new Date(a.data.duration.split(' ~ ')[0]);
  const bDate = new Date(b.data.duration.split(' ~ ')[0]);
  return bDate.getTime() - aDate.getTime();
});

const t = createTranslator(locale);
const description = t('site.playground_description', 'Interactive demos and experiments with frontend technologies');
---

<BaseLayout title={t('site.playground', 'Playground')} description={description} keywords={['playground', 'demo', 'interactive', 'frontend experiment']}>
  <div class="container">
    <h1>{t('site.playground', 'Playground')}</h1>
    <hr class="title-divider" />

    <div id="projects-wrapper" class="mt-8">
      {projects.map((project) => (
        <EachArticles locale={locale} frontmatter={project.data} url={localizePath(`/playground/${project.id}`, locale)} client:visible />
      ))}
    </div>
  </div>
</BaseLayout>
