---
import Flickering from '@/components/home/Flickering';
import InteractiveIconCloud from '@/components/home/InteractiveIconCloud';
import Intro from '@/components/home/Intro';
import TerminalInfo from '@/components/home/TerminalInfo';
import { LightRays } from '@/components/ui/light-rays';
import { Separator } from '@/components/ui/separator';
import { TextAnimate } from '@/components/ui/text-animate';
import BaseLayout from '@/layouts/baseLayout.astro';


// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
const description = 'Personal developer blog by Jun — web development, game development, and more';

---

<BaseLayout title="Home" description={description} keywords={['Jun', 'devlog', 'blog', 'web development', 'frontend']}>
  <div class="container overflow-x-hidden relative" data-home>
    <div class="light-rays-gate">
      <LightRays
        className="!fixed inset-0 z-0"
        count={8}
        speed={16}
        length="80vh"
        client:visible
      />
    </div>
    <div class="relative h-[200px] w-full">
      <div class="relative flex h-full flex-col items-center justify-center gap-4 px-6 text-center">
        <span class="text-xs font-semibold tracking-[0.35em] text-slate-800/60 uppercase dark:text-slate-200/60">
          Private Blog
        </span>
        <h1 class="text-foreground text-4xl font-bold md:text-5xl">
          Jun Devlog
        </h1>
      </div>
    </div>
    <div class="flex justify-center mt-6">
      <TerminalInfo client:visible />
    </div>
    <div id="intro" class="mt-12" data-home-content hidden>
      <div class="relative flex justify-center py-10">
        <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
          <Flickering client:visible />
        </div>
        <div class="intro-wrapper">
          <TextAnimate
            className="font-display text-center text-4xl font-bold tracking-[-0.02em] max-sm:text-2xl dark:text-slate-200 text-slate-700"
            by="character"
            animation="slideUp"
            text="Hello World! I'm Junja"
            client:visible
          />
          <Intro client:visible />
        </div>
      </div>
      <Separator className="my-8" />
      <TextAnimate
        className="font-display text-center text-4xl max-sm:text-2xl font-extrabold dark:text-slate-200 text-slate-700"
        by="character"
        animation="slideLeft"
        text="Technologies I've worked"
        client:visible
      />
      <div class="flex justify-center">

        <InteractiveIconCloud client:visible />
      </div>
    </div>



  </div>

</BaseLayout>

<style>
  .light-rays-gate {
    display: none;
  }
  @media (pointer: fine) and (min-width: 768px) {
    .light-rays-gate {
      display: block;
    }
  }
</style>
