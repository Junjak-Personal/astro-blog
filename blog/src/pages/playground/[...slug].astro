---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import MermaidInit from '@/components/layouts/MermaidInit.astro';
import ProjectLayout from '@/layouts/projectLayout.astro';
import { getLocalizedCollection } from '@/utils/localizedContent';


export async function getStaticPaths() {
  const posts = await getLocalizedCollection('playground', 'ko');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
    },
  }));
}
type Props = {
  post: CollectionEntry<'playground'>;
};


const { post } = Astro.props;
const { Content } = await render(post);
---

<ProjectLayout post={post.data} url={`/playground/${post.id}`}>
  <Content />
</ProjectLayout>

<MermaidInit />
