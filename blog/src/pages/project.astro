---
import { getCollection } from 'astro:content';
// Component Imports
import EachArticles from '@/components/Project/EachArticles';
import { createTranslator, getLocaleFromUrl, localizePath } from '@/i18n';
import BaseLayout from '@/layouts/baseLayout.astro';

const projects = await getCollection('project');
projects.sort((a, b) => {
  const aDate = new Date(a.data.duration.split(' ~ ')[0]);
  const bDate = new Date(b.data.duration.split(' ~ ')[0]);
  return bDate.getTime() - aDate.getTime();
});

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslator(locale);
const description = t('site.project_description', 'Portfolio of web and game development projects by Jun');
---

<BaseLayout title={t('site.project', 'Project')} description={description} keywords={['project', 'portfolio', 'web development']}>
  <div class="container">
    <h1 class="font-black">{t('site.project', 'Project')}</h1>
    <hr class="title-divider" />

    <div id="projects-wrapper" class="mt-8">
      {projects.map((project) => (
        <EachArticles locale={locale} frontmatter={project.data} url={localizePath(`/project/${project.id}`, locale)} client:visible />
      ))}
    </div>
  </div>
</BaseLayout>

