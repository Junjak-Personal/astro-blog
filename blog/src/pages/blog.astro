---
import dayjs from 'dayjs';
import Articles from '@/components/Blog/Articles';
// Component Imports
import { Skeleton } from '@/components/ui/skeleton';
import { createTranslator, getLocaleFromUrl } from '@/i18n';
import BaseLayout from '@/layouts/baseLayout.astro';

import { getLocalizedCollection } from '@/utils/localizedContent';

const locale = getLocaleFromUrl(Astro.url);
const posts = await getLocalizedCollection('blog', locale);
posts.sort((a, b) => dayjs(b.data.created).unix() - dayjs(a.data.created).unix());

const categories = [...new Set(posts.map((p) => p.data.category))];
const postsForClient = posts.map(({ body, ...rest }) => rest);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))];
const t = createTranslator(locale);
const description = t('site.blog_description', 'Articles on web development, game development, and developer diary');
---

<BaseLayout title={t('site.blog', 'Blog')} description={description} keywords={allTags}>
  <div class="container">
    <h1 class="font-black">{t('site.blog', 'Blog')}</h1>
    <hr class="title-divider" />

    <div id="articles-wrapper" class="mt-4">
      <Articles locale={locale} posts={postsForClient} categories={categories} client:visible>
        <div id="articles-skeleton" class="mt-8" slot="fallback">
          {[...Array.from({ length: 10 })].map((_) => (
            <div class="flex items-center space-x-4 h-[9.5rem]">
              <Skeleton className="size-[8rem] rounded-lg" />
              <div class="space-y-4">
                <Skeleton className="h-[1.5rem] w-[250px]" />
                <Skeleton className="h-[1rem] w-[300px]" />
                <Skeleton className="h-[1rem] w-[100px]" />
                <Skeleton className="h-[1rem] w-[150px]" />
              </div>
            </div>
          ))}
        </div>
      </Articles>
    </div>

  </div>
</BaseLayout>
