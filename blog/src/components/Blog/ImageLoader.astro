---
import { createTranslator, getLocaleFromUrl } from '@/i18n';
import { contentMessages } from '@/i18n/content';
// Lightweight server-rendered <img> for MDX blog posts (no client JS).
// Displays a downscaled webp variant (lighter); clicking opens the original
// full-res via the global ImageFullscreen handler (reads data-full).
// For lens zoom on hover, use ImageLoader.tsx with client:visible instead.
import { size, srcSet, variant } from '@/utils/imageVariant';

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslator(locale, contentMessages);

type Props = {
  src?: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
};

const { src = '', alt = t('blog-post.image', 'blog-image'), class: className, width, height } = Astro.props;

const display = variant(src, 960); // inline images render larger than gallery → 960 default
const set = srcSet(src, [480, 960, 1600]);
const full = display !== src ? src : undefined; // original for the lightbox (only when a variant is shown)
const dim = size(src); // original intrinsic {w,h} → aspect ratio reserved, no layout shift
---

<img
  src={display}
  srcset={set}
  sizes="(max-width: 768px) 92vw, 720px"
  alt={alt}
  loading="lazy"
  decoding="async"
  onerror="if(this.dataset.full){this.srcset='';this.src=this.dataset.full;this.dataset.full='';}else{this.onerror=null;this.src='/fallbackImg.svg';}"
  class:list={['cursor-zoom-in', className]}
  style="content-visibility:auto;contain-intrinsic-size:auto 360px;"
  width={width ?? dim?.w}
  height={height ?? dim?.h}
  data-full={full}
  data-lightbox
/>
