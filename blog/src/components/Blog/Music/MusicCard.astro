---
import { createTranslator, getLocaleFromUrl } from '@/i18n';
import { contentMessages } from '@/i18n/content';
import { size } from '@/utils/imageVariant';

const locale = getLocaleFromUrl(Astro.url);
const t = createTranslator(locale, contentMessages);

interface Props {
  appleMusicUrl: string;
  youtubeMusicUrl?: string;
  artist?: string;
  album?: string;
  releaseYear?: number;
  cover?: string; // album art (usually frontmatter.thumbnail)
}

const {
  appleMusicUrl,
  youtubeMusicUrl,
  artist,
  album,
  releaseYear,
  cover,
} = Astro.props;

const embedSrc = appleMusicUrl.replace(
  /^https:\/\/music\.apple\.com\//,
  'https://embed.music.apple.com/',
);

const coverDim = cover ? size(cover) : undefined;

const captionParts = [artist, album, releaseYear].filter(Boolean);
const caption = captionParts.join(' · ');
---

<div class="music-card my-8 flex flex-col gap-3">
  {cover && (
    <div class="music-card-cover rounded-xl overflow-hidden border border-border">
      <img
        src={cover}
        width={coverDim?.w}
        height={coverDim?.h}
        alt={[artist, album].filter(Boolean).join(' - ') || t('music-controls.cover', 'album cover')}
        decoding="async"
        fetchpriority="high"
      />
    </div>
  )}
  <div class="rounded-xl overflow-hidden border border-border">
    <iframe
      src={embedSrc}
      allow="autoplay *; encrypted-media *;"
      loading="lazy"
      width="100%"
      height="175"
      frameborder="0"
      title={`${artist ?? ''} ${album ?? ''} - Apple Music`}
    />
  </div>

  <div class="flex flex-wrap gap-2">
    <a
      class="inline-flex items-center justify-center rounded-md border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-3 text-sm"
      data-testid="music-apple-open"
      href={appleMusicUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t('music-controls.apple', 'Apple Music ↗')}
    </a>

    {youtubeMusicUrl && (
      <a
        class="inline-flex items-center justify-center rounded-md border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-3 text-sm"
        data-testid="music-youtube-open"
        href={youtubeMusicUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('music-controls.youtube', 'YouTube Music ↗')}
      </a>
    )}
  </div>

  {caption && (
    <p class="text-sm text-muted-foreground">{caption}</p>
  )}
</div>

<style>
  /* album cover: moderate hero, natural aspect ratio (square or wide both fit) */
  .music-card-cover {
    max-width: 22rem;
  }
  .music-card-cover img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
</style>
