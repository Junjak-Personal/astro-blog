---
import type { CollectionEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import dayjs from 'dayjs';
import dayJsRelativeTime from 'dayjs/plugin/relativeTime';
import BlogNav from '@/components/Blog/BlogNav';

import { PolaroidFlipLightbox } from '@/components/Blog/DiaryGallery';
import FloatButton from '@/components/layouts/FloatButton.astro';
import Footer from '@/components/layouts/Footer';
import ImageFullscreen from '@/components/layouts/ImageFullscreen.astro';
import Navigation from '@/components/layouts/Navigation';
import PelicaCursor from '@/components/layouts/PelicaCursor.astro';
import ThemeInit from '@/components/layouts/ThemeInit.astro';

import ScrollProgress from '@/components/ui/scroll-progress';
import { createTranslator, getLocaleFromUrl, htmlLanguage, localizePath } from '@/i18n';
import BlogFrontmatter from '../components/Blog/BlogFrontmatter';
import GiscusComp from '../components/Blog/GiscusComp';
import CommonScript from '../components/layouts/CommonScript.astro';
import CommonMeta from '../components/MetaAnalytics/CommonMeta.astro';
import JsonLd from '../components/MetaAnalytics/JsonLd.astro';
import VendorScript from '../components/MetaAnalytics/VendorScript.astro';
import { Separator } from '../components/ui/separator';

import { Skeleton } from '../components/ui/skeleton';
import 'react-photo-view/dist/react-photo-view.css';
import '@fontsource/gothic-a1';
import '@fontsource/m-plus-1p';
import '@fontsource/roboto';

import '@fontsource-variable/noto-sans-kr';
import '@/assets/styles/global.css';
import '@/assets/styles/index.scss';
import 'dayjs/locale/en';

dayjs.extend(dayJsRelativeTime);
dayjs.locale('en');

type Props = {
  post: CollectionEntry<'blog'>['data'];
  url: string;
  nav?: {
    prev: CollectionEntry<'blog'> | null;
    next: CollectionEntry<'blog'> | null;
  };
};

const { nav, post, url } = Astro.props;

const { title, tags = [], category = '', description: postDesc, thumbnail, created, updated } = post;
const blogDescription = postDesc || [title, category, ...tags].filter(Boolean).join(' | ');
const locale = getLocaleFromUrl(Astro.url);
const t = createTranslator(locale);

---

<html lang={htmlLanguage(locale)} data-locale={locale}>
  <head>
    <meta name="giscus:backlink" content="https://bit.ly/RickRolled" />
    <ClientRouter />
    <CommonMeta
      title={`Jun Devlog | ${title}`}
      description={blogDescription}
      keywords={tags}
      type="article"
      image={thumbnail}
      publishedTime={created}
      modifiedTime={updated}
      tags={tags}
    />
    <JsonLd
      schema={{
        type: 'article',
        title,
        description: blogDescription,
        image: thumbnail,
        publishedTime: created,
        modifiedTime: updated,
        tags,
      }}
      breadcrumbs={[
        { name: t('site.home', 'Home'), url: localizePath('/', locale) },
        { name: t('site.blog', 'Blog'), url: localizePath('/blog', locale) },
        { name: title, url: Astro.url.pathname },
      ]}
    />
    <VendorScript />
    <ThemeInit />
    <style></style>
  </head>
  <body>
    <PelicaCursor />
    <ImageFullscreen />
    <Navigation locale={locale} client:idle transition:persist="main-nav" />

    <main>
      <ScrollProgress
        className="scroll-animation top-[4rem] max-md:top-[3.5rem] bg-gradient-to-r from-neutral-200/30 via-neutral-200/70 to-neutral-200/30"
        client:idle
      />

      <div class="markdown-content-wrapper">
        <button
          type="button"
          id="go-back"
          data-testid="article-back-button"
          aria-label={t('site.go_back', 'Go back')}
          class="border border-current/20 rounded px-2 py-1 text-lg font-bold text-opacity-80 text-slate-600 dark:text-gray-300 hover:text-slate-900 dark:hover:text-gray-50 mb-2 w-fit cursor-pointer"
          onclick="history.go((window._mdEntryIndex ?? 0) - (history.state?.index ?? 0) - 1)"
        >
          {t('site.back_command', '> cd ..')}
        </button>
        <div class="front-matter-info">
          <BlogFrontmatter locale={locale} frontmatter={post} client:visible />
        </div>
        <div class="blog-nav">
          <BlogNav locale={locale} nav={nav} client:visible />
        </div>
        <div class="article-entry" lang={htmlLanguage(locale)} data-pagefind-body>
          {tags.map((tag) => (
            <meta data-pagefind-filter={`tag:${tag}`} />
          ))}
          <meta data-pagefind-filter={`category:${category}`} />
          <slot />
        </div>
        <div class="blog-nav">
          <BlogNav locale={locale} nav={nav} client:visible />
        </div>
        <Separator className="my-8" client:visible />

        <div class="giscus-body">
          <GiscusComp locale={locale} client:load>
            <div class="giscus-fallback" slot="fallback">
              <Skeleton className="h-[1rem] w-full]" />
              <Skeleton className="h-[1rem] w-full" />
              <Skeleton className="h-[1rem] w-full" />
            </div>
          </GiscusComp>
        </div>
        <div class="dummy-container"></div>
      </div>
    </main>
    <Footer locale={locale} client:idle transition:persist="main-footer" />
    <FloatButton />
    <PolaroidFlipLightbox locale={locale} client:idle />
    <CommonScript />
  </body>
</html>

<script is:inline>
window._mdEntryIndex = window.history.state?.index ?? 0;

(function scrollToSection() {
  const params = new URLSearchParams(window.location.search);
  const section = Number.parseInt(params.get('section'), 10);
  if (!section || section < 1)
    return;

  const headings = document.querySelectorAll('.article-entry h2');
  const target = headings[section - 1];
  if (!target)
    return;

  setTimeout(() => {
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 100);
})();
</script>
